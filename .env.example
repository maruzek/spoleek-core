APP_NAME=Spoleek
APP_URL=http://localhost:3000
DATABASE_URL=postgres://spoleek_admin:password@localhost:5432/spoleek
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_ENCRYPTION_KEY=replace-with-a-long-random-key-at-least-32-chars
# Only while rotating: the outgoing key, so existing ciphertext stays readable
# until it has been re-encrypted. Remove once the rotation is finished.
# APP_ENCRYPTION_KEY_PREVIOUS=
# The deployment's locale. "en" or "cs". This is the single base for every
# locale-dependent behaviour:
#   - language of the public, signed-out surface and the member-facing emails
#   - Intl formatting of every date, time and money amount in the app
#   - the name-sorting collation a new organization is seeded with at setup
# Admin and portal *copy* is still English regardless; only its formatting
# follows this.
DEFAULT_LOCALE=en
WORKSPACE_SYNC_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional future email delivery
# SMTP_FROM=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=