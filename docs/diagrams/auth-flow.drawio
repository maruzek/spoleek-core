<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17">
  <diagram id="auth-setup" name="1 · First-run setup &amp; strategy choice">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t100" value="First-run setup — /setup wizard (server/actions/bootstrap.ts, server/queries/bootstrap.ts)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="s2" value="Any request" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="s3" value="app/page.tsx (force-dynamic)&#xa;getBootstrapState()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="s4" value="Organization&#xa;row exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="240" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="s5" value="Sign-in panel&#xa;(see page 2)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="255" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="s6" value="DB unreachable → databaseIssue&#xa;is rendered inside the wizard&#xa;(banner, wizard still opens)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="s7" value="redirect('/setup')&#xa;SetupWizard, step from cookie" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="s8" value="Step 1 · Intent&#xa;deployment track (local / VPS / Vercel+Neon)&#xa;+ auth strategy → httpOnly setup cookie" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="450" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="s9" value="Step 2 · Environment&#xa;strategy-specific env snippet + commands&#xa;envGuidanceAccepted" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="550" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="s10" value="Step 3 · Readiness&#xa;getSetupEnvReadiness(): required keys&#xa;+ live Postgres connection probe" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="650" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="s11" value="canAdvance?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="750" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="s12" value="UX: issue list with error/warning&#xa;severity, Continue stays disabled" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="755" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="s13" value="Step 4 · First admin account" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="870" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="s14" value="authStrategy&#xa;= google-first?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="950" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="s15" value="createSetupEmailAdmin&#xa;internalAdapter.createUser (emailVerified=true)&#xa;+ linkAccount('credential', hash)&#xa;+ auth.api.signInEmail → session" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="950" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="s16" value="authClient.signIn.social('google')&#xa;→ back to /setup →&#xa;claimSetupSessionAdmin&#xa;(claims the live session as admin)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="950" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="s17" value="Email admin is refused on the&#xa;google-first path (server error):&#xa;'Google-first setup must use&#xa;the Google account flow.'" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="200" y="1060" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="s18" value="Google button is disabled while&#xa;GOOGLE_CLIENT_ID/SECRET are&#xa;missing; 'Claim session' disabled&#xa;until a viewer session exists" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1090" y="950" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="s19" value="Step 5 · Organization&#xa;createBootstrapOrganization: org row +&#xa;users.systemRole='system_admin' +&#xa;admin tenant_members row + clear cookie" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="1090" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="s20" value="Setup done → '/' now routes to /admin" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="610" y="1210" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="s21" value="The chosen strategy is persisted on the&#xa;organization (setupAuthStrategy) and is what&#xa;page 2 reads to decide which sign-in&#xa;controls are rendered." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1090" y="1090" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="s22" value="deriveSetupStep() re-reads the cookie on&#xa;every load, so a refresh or a lost session&#xa;drops the user back to the earliest&#xa;unfinished step instead of a blank page." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="200" y="450" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="e100" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e102" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e103" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="s4" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e105" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e108" value="No — fix env, retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="1" source="s11" target="s9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="790"/><mxPoint x="780" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="e109" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="s11" target="s13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e110" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s13" target="s14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e111" value="No — email/password&#xa;or email+Google" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="s14" target="s15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e112" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="s14" target="s16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e113" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s15" target="s19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e114" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s16" target="s19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e115" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="s19" target="s20"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="auth-signin" name="2 · Sign-in modes &amp; UI reaction">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t200" value="Sign-in at '/' — RootAuthPanel renders only what the setup strategy allows" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="g2" value="Visitor opens /" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="g3" value="getViewerSession()&#xa;auth.api.getSession(headers)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="125" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="g4" value="Valid session&#xa;cookie?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="g5" value="getViewerAppContext()&#xa;systemRole + tenant_members row&#xa;→ capabilities" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="g6" value="getDefault&#xa;SignedInRoute" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="100" height="80" as="geometry"/></mxCell>
        <mxCell id="g7" value="→ /portal (active member)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="60" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="g8" value="→ /admin (admin without member row)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="130" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="g9" value="→ /join (signed in, no membership)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="200" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="g10" value="Every /admin and /portal page goes&#xa;through requireViewerSession(), which&#xa;redirect()s to '/' when the session is&#xa;gone — no dedicated login route exists&#xa;(/auth just redirects to '/')." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="g11" value="RootAuthPanel(authStrategy, googleAvailable)&#xa;Badge shows the active strategy; the left card&#xa;explains which options are permitted" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="g20" value="Mode A · email-password" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="420" height="440" as="geometry"/></mxCell>
        <mxCell id="g21" value="Mode B · email-password-google" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="410" width="430" height="440" as="geometry"/></mxCell>
        <mxCell id="g22" value="Mode C · google-first" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="970" y="410" width="420" height="440" as="geometry"/></mxCell>
        <mxCell id="g23" value="UI: email + password fields,&#xa;'Sign in' button, plus an info Alert&#xa;'Invite-only account setup'.&#xa;No Google button at all." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="g24" value="authClient.signIn.email()&#xa;button label → 'Working...', disabled" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="560" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="g25" value="Credentials&#xa;accepted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="640" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="g26" value="Destructive Alert, aria-live=polite:&#xa;'Check your email and password, or&#xa;contact your administrator for a&#xa;fresh invite.' — one generic message,&#xa;no account enumeration" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="g27" value="router.push('/portal')&#xa;+ router.refresh()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="655" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="g30" value="UI: the same email form, a Separator,&#xa;then an outline 'Continue with Google'&#xa;button. Badge 'Google available'." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="450" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="g31" value="Email sign-in&#xa;(identical to Mode A)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="560" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="g32" value="authClient.signIn.social&#xa;({ provider: 'google' })" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="560" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="g33" value="Degraded case — strategy wants Google&#xa;but GOOGLE_CLIENT_ID/SECRET are missing:&#xa;destructive Alert 'Google is configured in&#xa;setup, but unavailable now.' The email form&#xa;still works, so nobody is locked out." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="650" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="g34" value="socialProviders is only registered when&#xa;isGoogleAuthEnabled — the provider is absent&#xa;server-side too, not merely hidden in the UI." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="760" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="g40" value="UI: no email form at all.&#xa;Info Alert (lock icon) 'Google-first&#xa;deployment — this setup path expects&#xa;members to enter through Google&#xa;sign-in.' + Google button only." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="g41" value="authClient.signIn.social&#xa;({ provider: 'google' })" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="g42" value="Hard failure mode — if Google env vars&#xa;are missing here, the panel shows only&#xa;the destructive 'unavailable' Alert and&#xa;there is no fallback: no sign-in is&#xa;possible until the env is fixed.&#xa;(Invite emails are also disabled on this&#xa;track by getSetupInstructions.)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="650" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="g50" value="Better Auth callback&#xa;/api/auth/[...all] → cookie via nextCookies()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="900" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="g51" value="First Google sign-in for this email?&#xa;databaseHooks.user.create.after →&#xa;linkUserToWorkspaceMember()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="990" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="g52" value="Unlinked member with&#xa;matching workspaceUserEmail&#xa;and workspaceProvisionedAt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="690" y="1100" width="140" height="120" as="geometry"/></mxCell>
        <mxCell id="g53" value="Set tenant_members.userId + linkedAt,&#xa;log 'workspace_user_linked'&#xa;→ callbackURL /portal, full member UI" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1120" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="g54" value="Signed in but memberless:&#xa;capabilities are empty →&#xa;redirected to /join to apply.&#xa;Sidebar shows no portal/admin sections." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="1120" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="g55" value="Asymmetry worth knowing:&#xa;emailAndPassword.disableSignUp = true, so&#xa;there is no password self-registration — but&#xa;Google sign-in DOES create a user row for any&#xa;Google account. Membership, not the user row,&#xa;is what grants access." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="960" y="960" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="g56" value="Two members share the same workspace email&#xa;→ the first is linked and the event records&#xa;ambiguous: true (silent to the user, visible&#xa;in the member auth event log)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="960" y="1230" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="ge01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge03" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="g6" target="g7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="g6" target="g8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge07" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#f57c00;strokeWidth=2;" edge="1" parent="1" source="g6" target="g9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge08" value="No session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g4" target="g11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge09" value="A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g11" target="g20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge10" value="B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g11" target="g21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge11" value="C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g11" target="g22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g24" target="g25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g25" target="g26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g25" target="g27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g32" target="g50"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g41" target="g50"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g50" target="g51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="g51" target="g52"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge19" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g52" target="g53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ge20" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#f57c00;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="g52" target="g54"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="auth-invite" name="3 · Invite issuing (join → approve → email)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t300" value="How a member account comes into existence — accounts are created by invitation, never by self sign-up" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="l1" value="Applicant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1880" height="150" as="geometry"/></mxCell>
        <mxCell id="l2" value="Org administrator (/admin/members)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="1880" height="190" as="geometry"/></mxCell>
        <mxCell id="l3" value="Server — sendMemberActivationInvite() + Better Auth sendResetPassword hook" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="1880" height="380" as="geometry"/></mxCell>
        <mxCell id="l4" value="Email (Resend) + audit trail" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1880" height="190" as="geometry"/></mxCell>
        <mxCell id="a1" value="Opens /join" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="a2" value="PublicJoinForm + registration&#xa;custom fields → submitJoinApplication&#xa;→ tenant_members.status = 'pending'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="130" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="a3" value="No account, no session yet — /join is fully&#xa;public and only records an application.&#xa;If the deployment has no organization,&#xa;/join redirects to /setup." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="b1" value="Review the request → Approve&#xa;status: pending → invited" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="190" y="320" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="b2" value="'Send activation email'&#xa;sendMemberActivationInvite({ memberId, force? })" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="b3" value="Admin UX: the returned reason drives the toast —&#xa;sent · already-sent · cooldown · suppressed ·&#xa;already-completed · already-active. Resend is a&#xa;deliberate 'force' action, and delivery state&#xa;(sent/bounced/complained) is shown on the member row." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="830" y="290" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="b4" value="Only 'invited' or 'active' members may be&#xa;invited, and an email address is required —&#xa;otherwise the action throws and the dialog&#xa;surfaces the message." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="1280" y="290" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="c1" value="log invite_send_requested" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="520" width="180" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="Guards&#xa;already linked? · invite completed? ·&#xa;email bounced/complained/suppressed? ·&#xa;unexpired invite and not forced? ·&#xa;resend cooldown (5 min) active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="260" height="220" as="geometry"/></mxCell>
        <mxCell id="c3" value="Skip: log invite_send_skipped&#xa;with the reason, send nothing" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="760" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="c4" value="ensureMemberInviteUser()&#xa;user row + credential-less account,&#xa;then upsertProvisionedUser() records&#xa;provisionedUserId on member_invites" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="560" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="c5" value="auth.api.requestPasswordReset({ email,&#xa;redirectTo: /activate-account?member=…&amp;mode=invite })&#xa;— the invite rides Better Auth's reset-token machinery" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="560" width="380" height="80" as="geometry"/></mxCell>
        <mxCell id="c6" value="sendResetPassword hook&#xa;isMemberActivationResetUrl(url)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1420" y="520" width="200" height="160" as="geometry"/></mxCell>
        <mxCell id="c7" value="Plain reset email&#xa;'reset your password' + link&#xa;idempotencyKey password-reset/&lt;user&gt;/&lt;token&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="500" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="c8" value="Branded MemberActivationEmail (React Email)&#xa;org name, admin-authored subject/body,&#xa;activation URL, member name&#xa;idempotencyKey member-activation/&lt;memberId&gt;/&lt;token&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="620" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="c9" value="Resend accepted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="740" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="d1" value="markMemberInviteSent(memberId, token, providerEmailId)&#xa;+ recordMemberInviteEmailSent + logMemberAuthEvent&#xa;'password_reset_sent' → invite status 'sent',&#xa;token hash + expiry + resend cooldown stored" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1160" y="900" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="d2" value="markMemberInviteFailed + recordMemberInviteEmailFailed,&#xa;then rethrow → admin sees the real error message" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1590" y="910" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="d3" value="Resend webhooks (/api/resend) later flip&#xa;deliveryStatus to delivered/bounced/complained,&#xa;which is exactly what the 'suppressed' guard&#xa;above reads on the next send attempt." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="700" y="900" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="d4" value="Every step is written to the member auth event log&#xa;(invite_send_requested / _skipped, password_reset_sent,&#xa;activation_attempt_blocked, invite_completed,&#xa;workspace_user_linked) — the audit trail an admin reads&#xa;when a member says 'I never got the email'." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="890" width="440" height="100" as="geometry"/></mxCell>
        <mxCell id="de01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de02" value="admin notified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="a2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="b2" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de06" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de07" value="clear to send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de09" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de10" value="no (ordinary reset)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de11" value="yes (member=… &amp;amp; mode=invite)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c9" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de14" value="no / throws" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c9" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de15" value="member opens the link → page 4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="d1" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="auth-activation" name="4 · Activation link → portal">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t400" value="/activate-account — guard cascade, then password creation and auto sign-in" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="h1" value="Member clicks the invite link" style="ellipse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="80" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="h2" value="Better Auth verifies the reset token, then&#xa;redirects to /activate-account?member=…&amp;token=…&#xa;(or …&amp;error=… when the token is bad)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="70" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="h3" value="markMemberInviteExpiredIfNeeded()&#xa;then the guard cascade below" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="170" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="h4" value="Already&#xa;signed in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="h5" value="redirect('/portal') — no activation screen" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="275" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="h6" value="member + token present&#xa;and no ?error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="380" width="120" height="100" as="geometry"/></mxCell>
        <mxCell id="h7" value="Member status is&#xa;invited or active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="520" width="120" height="100" as="geometry"/></mxCell>
        <mxCell id="h8" value="Invite completed&#xa;or member already&#xa;linked to a user?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="660" width="140" height="110" as="geometry"/></mxCell>
        <mxCell id="h9" value="activationBlockedUntil&#xa;in the future?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="810" width="140" height="110" as="geometry"/></mxCell>
        <mxCell id="h10" value="getValidMemberInvite&#xa;(hashed token matches,&#xa;not expired)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="960" width="160" height="120" as="geometry"/></mxCell>
        <mxCell id="x1" value="Screen: 'This activation link is invalid.'&#xa;+ 'Ask an administrator to send a fresh&#xa;invitation and open only the newest link.'&#xa;+ 'Back to sign in' button" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="390" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="x2" value="Same 'invalid' screen — an archived or&#xa;deleted member gets no hint that the&#xa;member exists" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="530" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="x3" value="Screen: 'This account has already been&#xa;activated.' → sign in with the approved&#xa;email and password instead" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="670" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="x4" value="Screen: 'Too many activation attempts were&#xa;detected.' — shows the exact local time when&#xa;the block lifts (5 attempts → 15 min block)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="820" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="x5" value="Screen: 'This activation link has expired.'&#xa;when the invite is expired, otherwise the&#xa;generic 'invalid' screen" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="970" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="h11" value="Activation page renders: org name, the&#xa;sign-in email (read-only) and&#xa;MemberActivationForm — create password,&#xa;confirm, plus 'post_approval' custom fields" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1120" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="h12" value="completeMemberActivationAction&#xa;(TanStack Form + useAction; button →&#xa;'Finishing setup...', disabled while pending)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1240" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="h13" value="registerActivationAttempt()&#xa;blocked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="1350" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="x6" value="serverError Alert: 'Too many activation&#xa;attempts were detected…' — form stays&#xa;filled, button re-enabled" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1370" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="h14" value="Zod (password ≥ 12, passwords match)&#xa;+ custom field validation OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="1500" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="x7" value="Inline errors — validationErrors under the&#xa;password fields, customFieldErrors on each&#xa;question; nothing is written to the DB" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1525" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="h15" value="auth.api.resetPassword(token)&#xa;sets the credential password&#xa;(revokeSessionsOnPasswordReset)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1650" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="h16" value="Transaction: save custom-field answers,&#xa;tenant_members.userId = provisionedUserId,&#xa;status = 'active', linkedAt set" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="1730" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="h17" value="generatePaymentForMember() +&#xa;markMemberInviteCompleted() (invite_completed)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1730" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="h18" value="auth.api.signInEmail() → session cookie,&#xa;then router.push('/portal') + refresh()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1820" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="x8" value="If that last sign-in fails the user sees&#xa;'Your password was saved, but automatic&#xa;sign-in failed.' — activation IS complete,&#xa;so the fix is to sign in normally at '/'." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#f57c00;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="900" y="1810" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="x9" value="Design intent: every rejection path lands on&#xa;a calm explanatory screen with one action&#xa;('Back to sign in') and tells the member to&#xa;ask an admin for a fresh link — never a raw&#xa;error and never a hint about which condition&#xa;failed." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="380" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="x10" value="Rate limiting is two-layered: the page blocks&#xa;before rendering the form, and the action&#xa;re-checks on submit — 5 attempts inside a&#xa;15-minute window then a 15-minute block,&#xa;each block logged as activation_attempt_blocked." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="840" y="1130" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="he01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he04" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he05" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h4" target="h6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he06" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h6" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he07" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h6" target="h7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he08" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h7" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he09" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h7" target="h8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he10" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#f57c00;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h8" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he11" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h8" target="h9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h9" target="x4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h9" target="h10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he14" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h10" target="x5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h10" target="h11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he16" value="submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h11" target="h12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="h12" target="h13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he18" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h13" target="x6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he19" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h13" target="h14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he20" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h14" target="x7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he21" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="h14" target="h15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="h15" target="h16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="h16" target="h17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="h17" target="h18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="he25" value="retry with a newer link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="1" source="x6" target="h11"><mxGeometry relative="1" as="geometry"/></mxCell>
